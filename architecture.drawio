        <mxCell id="e_fld5" value="&lt;b&gt;TTL (Time To Live)&lt;/b&gt; (1 byte, default=5)&#xa;Decremented by 1 at each forward" style="rounded=1;fillColor=#162036;strokeColor=#FF5A4E;fontColor=#FF5A4E;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="1555" width="310" height="40" as="geometry" /></mxCell>
        <mxCell id="e_fld6" value="&lt;b&gt;Hop Count&lt;/b&gt; (1 byte, initial=0)&#xa;Incremented by 1 at each hop" style="rounded=1;fillColor=#162036;strokeColor=#3CC6D0;fontColor=#3CC6D0;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1530" y="1555" width="310" height="40" as="geometry" /></mxCell>
        <mxCell id="e_fld7" value="&lt;b&gt;Payload (Variable &amp;lt; 512 bytes)&lt;/b&gt;&#xa;Compressed JSON / CBOR (Text, GPS, Emergency Type)" style="rounded=1;fillColor=#162036;strokeColor=#26344F;fontColor=#EEF2F8;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="1605" width="310" height="40" as="geometry" /></mxCell>
        <mxCell id="e_fld8" value="&lt;b&gt;CRC32 / HMAC-SHA256&lt;/b&gt; (4-32 bytes)&#xa;Tamper detection &amp; frame integrity" style="rounded=1;fillColor=#162036;strokeColor=#26344F;fontColor=#EEF2F8;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1530" y="1605" width="310" height="40" as="geometry" /></mxCell>

        <!-- Save-Before-Send Flowchart Box -->
        <mxCell id="pipe_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1627;strokeColor=#4CD08A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1900" y="1415" width="1380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="pipe_title" value="&lt;b style=&quot;color:#4CD08A;&quot;&gt;Save-Before-Send Transaction Sequence &amp; Epidemic Deduplication Flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1920" y="1425" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st1" value="1. User taps&#xa;Send SOS / Message" style="rounded=1;fillColor=#162036;strokeColor=#FFD21F;fontColor=#EEF2F8;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1920" y="1465" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="st2" value="2. SQLite Write&#xa;Status: 'SAVED'&#xa;Committed to disk" style="rounded=1;fillColor=#162036;strokeColor=#4CD08A;fontColor=#4CD08A;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="2110" y="1465" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="st3" value="3. BLE Broadcast&#xa;Adv Data Packet&#xa;Status: 'SENT_NEARBY'" style="rounded=1;fillColor=#162036;strokeColor=#3CC6D0;fontColor=#3CC6D0;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="2300" y="1465" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="st4" value="4. Peer Ingests&#xa;Dedup Check in SQLite&#xa;Seen? Drop!" style="rounded=1;fillColor=#162036;strokeColor=#FF5A4E;fontColor=#FF5A4E;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="2490" y="1465" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="st5" value="5. TTL Guard&#xa;TTL &amp;gt; 1 ? Decrement &amp; Forward&#xa;TTL &amp;lt;= 1 ? Halt" style="rounded=1;fillColor=#162036;strokeColor=#FFA033;fontColor=#FFA033;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="2680" y="1465" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="st6" value="6. Gateway Reach&#xa;Cloud Uplink Sync&#xa;Status: 'DELIVERED'" style="rounded=1;fillColor=#162036;strokeColor=#4CD08A;fontColor=#FFFFFF;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="2880" y="1465" width="150" height="60" as="geometry" /></mxCell>

        <!-- Sequence Arrows -->
        <mxCell id="arr1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FFD21F;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4CD08A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3CC6D0;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF5A4E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st4" target="st5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FFA033;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st5" target="st6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="pipe_expl" value="&lt;b&gt;Guaranteed Zero Message Loss In Zero-Connectivity Environments:&lt;/b&gt;&lt;br/&gt;Even if battery dies immediately after pressing Send, the message is durably written to non-volatile SQLite flash memory. Upon reboot or proximity encounter with any peer node, the mesh outbox automatically resumes opportunistic relaying." style="rounded=1;fillColor=#162036;strokeColor=#26344F;fontColor=#EEF2F8;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1920" y="1560" width="1340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
